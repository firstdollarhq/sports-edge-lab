# Kalshi market-data reads need no key (public REST API).
# The Odds API is optional -- only needed if/when we want a second,
# traditional-sportsbook odds source to compare against Kalshi's exchange
# prices. Free tier only covers NBA/MLB; NFL/soccer need a paid plan
# (Professional, ~$29/mo, all 25 sports incl. NFL/EPL).
ODDS_API_KEY=

# football-data.org is only needed for *live/current-season* soccer fixtures
# and standings (free, no card, self-serve at football-data.org/client/register).
# Historical results+odds for backtesting come from football-data.co.uk and
# need no key at all.
FOOTBALL_DATA_ORG_API_KEY=
